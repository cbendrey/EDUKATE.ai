{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Slack output",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/learner_progress_summariser.py",
      "args": ["${workspaceFolder}/Set1.json", "--output-format", "slack"],
      "console": "integratedTerminal"
    },
    {
      "name": "Debug email output",
      "type": "debugpy",
