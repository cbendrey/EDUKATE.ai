      "program": "${workspaceFolder}/learner_progress_summariser.py",
      "args": ["${workspaceFolder}/Set1.json", "--output-format", "email"],
      "console": "integratedTerminal"
    },
    {
      "name": "Debug JSON output",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/learner_progress_summariser.py",
      "args": ["${workspaceFolder}/Set1.json"],
      "console": "integratedTerminal"
    }
  ]
}